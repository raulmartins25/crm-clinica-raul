generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
  ASSISTANT
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  STICKER
  LOCATION
  CONTACT
  REACTION
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum DocumentType {
  PRESCRIPTION
  EXAM_REQUEST
  REPORT
  CERTIFICATE
  REFERRAL
  OTHER
}

enum AgentStatus {
  ACTIVE
  PAUSED
  INACTIVE
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  EXPIRED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  PIX
  BANK_TRANSFER
  HEALTH_INSURANCE
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  CANCELLED
  REFUNDED
}

// ─── CLINIC ────────────────────────────────────────────────────────────
model Clinic {
  id                  String   @id @default(cuid())
  name                String
  cnpj                String?  @unique
  phone               String?
  email               String?
  address             String?
  city                String?
  state               String?
  zipCode             String?
  logoUrl             String?
  website             String?
  specialty           String?
  clinicType          String?
  onboardingCompleted Boolean  @default(false)
  responsavelTecnico  String?
  numeroConselho      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users                 User[]
  patients              Patient[]
  appointments          Appointment[]
  whatsappInstance      WhatsappInstance?
  aiAgents              AIAgent[]
  emailConfig           EmailConfig?
  googleCalendar        GoogleCalendarConfig?
  payments              Payment[]
  professionalSchedules ProfessionalSchedule[]
  stockItems            StockItem[]
  stockMovements        StockMovement[]
}

// ─── USERS ─────────────────────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  clinicId     String
  name         String
  email        String   @unique
  password     String
  role         UserRole @default(RECEPTIONIST)
  crm          String?
  specialty    String?
  phone        String?
  avatarUrl    String?
  color        String?
  roomDefault  String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clinic          Clinic        @relation(fields: [clinicId], references: [id])
  appointments    Appointment[] @relation("DoctorAppointments")
  sentMessages    Message[]     @relation("SentBy")
  documents       Document[]    @relation("CreatedByUser")
  medicalRecords  MedicalRecord[] @relation("RecordDoctor")
  paymentsCreated Payment[]     @relation("PaymentCreator")
  schedule        ProfessionalSchedule[]
  stockMovements  StockMovement[]  @relation("StockPerformer")
}

// ─── PATIENTS ──────────────────────────────────────────────────────────
model Patient {
  id           String    @id @default(cuid())
  clinicId     String
  name         String
  cpf          String?
  birthDate    DateTime?
  gender       String?
  phone        String
  phone2       String?
  email        String?
  address      String?
  city         String?
  state        String?
  zipCode      String?
  bloodType    String?
  allergies    String?
  observations String?
  avatarUrl    String?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  clinic         Clinic          @relation(fields: [clinicId], references: [id])
  conversations  Conversation[]
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  documents      Document[]
  payments       Payment[]
}

// ─── WHATSAPP ──────────────────────────────────────────────────────────
model WhatsappInstance {
  id           String   @id @default(cuid())
  clinicId     String   @unique
  instanceName String   @unique
  apiKey       String
  baseUrl      String
  connected    Boolean  @default(false)
  phoneNumber  String?
  qrCode       String?
  webhookUrl   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id])
}

model Conversation {
  id              String    @id @default(cuid())
  patientId       String?
  remoteJid       String
  remotePhone     String
  remoteName      String?
  remoteAvatarUrl String?
  unreadCount     Int       @default(0)
  lastMessageAt   DateTime?
  lastMessageText String?
  aiEnabled       Boolean   @default(false)
  agentId         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  patient  Patient?  @relation(fields: [patientId], references: [id])
  agent    AIAgent?  @relation(fields: [agentId], references: [id])
  messages Message[]

  @@unique([remoteJid])
}

model Message {
  id              String           @id @default(cuid())
  conversationId  String
  externalId      String?          @unique
  direction       MessageDirection
  type            MessageType      @default(TEXT)
  content         String?
  mediaUrl        String?
  mediaName       String?
  mediaMimeType   String?
  mediaSize       Int?
  status          MessageStatus    @default(SENT)
  sentById        String?
  isFromAI        Boolean          @default(false)
  timestamp       DateTime         @default(now())
  createdAt       DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sentBy       User?        @relation("SentBy", fields: [sentById], references: [id])
}

// ─── APPOINTMENTS ──────────────────────────────────────────────────────
model Appointment {
  id              String            @id @default(cuid())
  clinicId        String
  patientId       String
  doctorId        String
  title           String
  description     String?
  startTime       DateTime
  endTime         DateTime
  status          AppointmentStatus @default(SCHEDULED)
  type            String?
  room            String?
  price           Float?
  notes           String?
  reminderSent          Boolean           @default(false)
  googleEventId         String?
  recurrence            String?
  recurrenceEnd         DateTime?
  parentId              String?
  isReturn              Boolean           @default(false)
  postAppointmentSent   Boolean           @default(false)
  returnSuggestionSent  Boolean           @default(false)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  clinic   Clinic   @relation(fields: [clinicId], references: [id])
  patient  Patient  @relation(fields: [patientId], references: [id])
  doctor   User     @relation("DoctorAppointments", fields: [doctorId], references: [id])
  payment  Payment?
}

// ─── MEDICAL RECORDS ───────────────────────────────────────────────────
model MedicalRecord {
  id              String   @id @default(cuid())
  patientId       String
  doctorId        String
  appointmentId   String?
  chiefComplaint  String?
  anamnesis       String?
  physicalExam    String?
  diagnosis       String?
  icdCode         String?
  treatment       String?
  observations    String?
  bloodPressure   String?
  heartRate       Int?
  temperature     Float?
  weight          Float?
  height          Float?
  oxygenSat       Float?
  extraData       Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])
  doctor  User    @relation("RecordDoctor", fields: [doctorId], references: [id])
}

// ─── DOCUMENTS ─────────────────────────────────────────────────────────
model Document {
  id          String       @id @default(cuid())
  patientId   String
  createdById String
  type        DocumentType @default(PRESCRIPTION)
  title       String
  content     String
  htmlContent String?
  pdfUrl      String?
  sentWhatsapp      Boolean   @default(false)
  sentEmail         Boolean   @default(false)
  signatureToken    String?   @unique
  signatureStatus   String?
  signedAt          DateTime?
  signatureImageUrl String?
  signerName        String?
  signerCpf         String?
  ipAddress         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  patient   Patient @relation(fields: [patientId], references: [id])
  createdBy User    @relation("CreatedByUser", fields: [createdById], references: [id])
}

// ─── AI AGENTS ─────────────────────────────────────────────────────────
model AIAgent {
  id              String      @id @default(cuid())
  clinicId        String
  name            String
  description     String?
  status          AgentStatus @default(ACTIVE)
  masterPrompt    String      @db.Text
  temperature     Float       @default(0.7)
  model           String      @default("deepseek-chat")
  maxTokens       Int         @default(1024)
  voiceTone       String?
  empathyLevel    String?
  workingHoursStart String?
  workingHoursEnd   String?
  workingDays       String?
  awayMessage       String?
  transferKeywords  String[]
  // Follow-up
  followUpEnabled   Boolean   @default(false)
  followUpMinutes   Int       @default(30)
  followUpMessage   String?   @db.Text
  // Appointment Confirmation
  appointmentConfirmEnabled Boolean @default(false)
  appointmentConfirmHours   Int     @default(24)
  appointmentConfirmMessage String? @db.Text
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  clinic          Clinic           @relation(fields: [clinicId], references: [id])
  knowledgeItems  KnowledgeItem[]
  conversations   Conversation[]
  agentMessages   AgentMessage[]
}

model KnowledgeItem {
  id        String   @id @default(cuid())
  agentId   String
  title     String
  content   String   @db.Text
  category  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  agent AIAgent @relation(fields: [agentId], references: [id])
}

model AgentMessage {
  id             String   @id @default(cuid())
  agentId        String
  conversationId String
  role           String
  content        String   @db.Text
  createdAt      DateTime @default(now())

  agent AIAgent @relation(fields: [agentId], references: [id])
}

// ─── CONFIGURATIONS ────────────────────────────────────────────────────
model EmailConfig {
  id        String  @id @default(cuid())
  clinicId  String  @unique
  host      String
  port      Int     @default(587)
  secure    Boolean @default(false)
  user      String
  password  String
  fromName  String
  fromEmail String

  clinic Clinic @relation(fields: [clinicId], references: [id])
}

model GoogleCalendarConfig {
  id           String   @id @default(cuid())
  clinicId     String   @unique
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  calendarId   String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id])
}

// ─── PROFESSIONAL SCHEDULES ─────────────────────────────────────────────────
model ProfessionalSchedule {
  id          String   @id @default(cuid())
  userId      String
  clinicId    String
  dayOfWeek   Int      // 0=Dom, 1=Seg, 2=Ter, 3=Qua, 4=Qui, 5=Sex, 6=Sab
  startTime   String   // ex: "08:00"
  endTime     String   // ex: "18:00"
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@unique([userId, dayOfWeek])
}

// ─── FINANCIAL ─────────────────────────────────────────────────────────────
model Payment {
  id            String        @id @default(cuid())
  clinicId      String
  patientId     String
  appointmentId String?       @unique
  amount        Float
  amountPaid    Float         @default(0)
  discount      Float         @default(0)
  method        PaymentMethod @default(PIX)
  status        PaymentStatus @default(PENDING)
  dueDate       DateTime?
  paidAt        DateTime?
  notes         String?
  receiptSent   Boolean       @default(false)
  createdById   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  clinic      Clinic       @relation(fields: [clinicId], references: [id])
  patient     Patient      @relation(fields: [patientId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  createdBy   User         @relation("PaymentCreator", fields: [createdById], references: [id])
}

// ─── STOCK ─────────────────────────────────────────────────────────────────────
model StockItem {
  id             String    @id @default(cuid())
  clinicId       String
  name           String
  description    String?
  category       String?
  unit           String
  quantity       Float     @default(0)
  minQuantity    Float     @default(0)
  maxQuantity    Float?
  costPrice      Float?
  supplier       String?
  expirationDate DateTime?
  location       String?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  clinic    Clinic          @relation(fields: [clinicId], references: [id])
  movements StockMovement[]
}

model StockMovement {
  id          String            @id @default(cuid())
  clinicId    String
  itemId      String
  type        StockMovementType
  quantity    Float
  unitCost    Float?
  totalCost   Float?
  reason      String?
  performedBy String
  createdAt   DateTime          @default(now())

  clinic    Clinic    @relation(fields: [clinicId], references: [id])
  item      StockItem @relation(fields: [itemId], references: [id])
  performer User      @relation("StockPerformer", fields: [performedBy], references: [id])
}
